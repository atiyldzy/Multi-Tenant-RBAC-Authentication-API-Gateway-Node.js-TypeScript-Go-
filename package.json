{
  "name": "enterprise-auth-api-gateway",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-Ready Multi-Tenant Authentication and API Gateway Service with RS256 JWT, Distributed Rate Limiting, RBAC & Reverse Proxy",
  "main": "dist/server.js",
  "scripts": {
    "generate-keys": "node node_modules/tsx/dist/cli.mjs src/scripts/generateKeys.ts",
    "migrate": "node node_modules/tsx/dist/cli.mjs src/database/migrator.ts",
    "seed": "node node_modules/tsx/dist/cli.mjs src/database/seeds/seed.ts",
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit"
  },
  "keywords": [
    "multi-tenant",
    "api-gateway",
    "jwt-rs256",
    "rbac",
    "rate-limiting",
    "redis",
    "postgresql",
    "reverse-proxy",
    "typescript"
  ],
  "author": "Cloud Solutions & Security Engineering Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "@types/yamljs": "^0.2.34",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
