# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
GATEWAY_PREFIX=/gateway

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_gateway_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_gateway_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RS256 JWT Configuration
JWT_ISSUER=auth.gateway.enterprise
JWT_AUDIENCE=enterprise.api.gateway
JWT_ACCESS_EXPIRATION_SECONDS=900 # 15 minutes
JWT_REFRESH_EXPIRATION_SECONDS=604800 # 7 days
KEY_PATH_PRIVATE=./keys/private.pem
KEY_PATH_PUBLIC=./keys/public.pem

# Rate Limiting Defaults
RATE_LIMIT_GLOBAL_WINDOW_SEC=60
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_WINDOW_SEC=60
RATE_LIMIT_AUTH_MAX=10

# Security & CORS
CORS_ORIGIN=*
BCRYPT_ROUNDS=12
